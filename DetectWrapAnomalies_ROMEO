import nibabel as nib
import numpy as np
import matplotlib.pyplot as plt

## Load wrapped phase volume

IN="/home/hayabusa/PROJECT_MPN/MPN_BIDS/sub-MPN0000087/ses-MPN1Scan1/anat/sub-MPN0000087_ses-MPN1Scan1_acq-aspire_echo-1_part-phase_T2starw.nii.gz"

## Load alternatively an unwrapped phase volume
#IN="/home/hayabusa/PROJECT_MPN/MPN_BIDS/sub-MPN0000087/ses-MPN1Scan1/anat/sub-MPN0000087_ses-MPN1Scan1_acq-romeo_echo-1_part-phase_T2starw.nii.gz"

img = nib.load(IN)
data = img.get_fdata()

# Calculate gradient along the z-axis (or 3D spatial gradient)
grad_z = np.gradient(data, axis=2)
grad_y = np.gradient(data, axis=1)
grad_x = np.gradient(data, axis=0)

# Find locations where gradient exceeds pi (indicating a residual wrap/error)
wrap_errors = np.abs(grad_z) > np.pi
error_count = np.sum(wrap_errors)
error_percentage = (error_count / data.size) * 100

print(f"Residual wrap anomalies detected in Z direction: {error_percentage:.4f}%")

wrap_errors = np.abs(grad_y) > np.pi
error_count = np.sum(wrap_errors)
error_percentage = (error_count / data.size) * 100

print(f"Residual wrap anomalies detected in Y direction: {error_percentage:.4f}%")

wrap_errors = np.abs(grad_x) > np.pi
error_count = np.sum(wrap_errors)
error_percentage = (error_count / data.size) * 100

print(f"Residual wrap anomalies detected in X direction: {error_percentage:.4f}%")

