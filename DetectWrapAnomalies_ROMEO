E4="/home/hayabusa/PROJECT_MPN/MPN_BIDS/sub-MPN0000087/ses-MPN1Scan1/anat/sub-MPN0000087_ses-MPN1Scan1_acq-romeo_echo-4_part-phase_T2starw.nii.gz"
