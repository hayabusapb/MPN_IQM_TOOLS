from scipy.stats import linregress

# 1. Define multi-echo file paths and corresponding TE values (in ms or seconds)
################################################################################
## E.g subject MPN87

## echo1:
E1="/home/hayabusa/PROJECT_MPN/MPN_BIDS/sub-MPN0000087/ses-MPN1Scan1/anat/sub-MPN0000087_ses-MPN1Scan1_acq-romeo_echo-1_part-phase_T2starw.nii.gz"
