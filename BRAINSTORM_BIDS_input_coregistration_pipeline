
#  CREATE BRAINSTORM_BIDS STRUCTURE AND SYMLINKS TO MEG AND MRI DATA 
#  PATHS TO RAW MEG, CBRAIN_BIDS AND MPN_QC DERIVATIVES DATA: 
#  MEG full directory, MRI structural T1w files and jsons, Head Surfaces from MideFAce 
# Create a brainstorm participant folder



cd ~/MOUNT_MPN/

SF=./MPN_QC

for sj in ./MEG/sub-*;do

sid=$(echo "${sj}" | grep -Po 'sub-.{10}');
echo 'processing participant: '${sid}

for ssn in ${sj}/ses-*;do
       
       ses='ses-MEG'$(echo "${ssn}" | grep -Po 'ses-\K.*');
       echo ${ses}
       mkdir -p -m777 ./MEG_PREP/BRAINSTORM_BIDS/${sid}/${ses}/meg/
       mkdir -p -m777 ./MEG_PREP/BRAINSTORM_BIDS/${sid}/${ses}/anat/
       
       ## Relative symlinks to mount root
       ln -s "${ssn}"/meg ./MEG_PREP/BRAINSTORM_BIDS/"${sid}"/"${ses}"/meg/      
       
       ln -s ./MEG_PREP/"${sid}"_ses-MPN1Scan1_T1w.nii.gz ./MEG_PREP/BRAINSTORM_BIDS/"${sid}"/"${ses}"/anat/"${sid}"_ses-MPN1Scan1_T1w.nii.gz
       
       ln -s ./MEG_PREP/"${sid}"_ses-MPN1Scan1_T1w.json ./MEG_PREP/BRAINSTORM_BIDS/"${sid}"/"${ses}"/anat/"${sid}"_ses-MPN1Scan1_T1w.json
       
       mkdir -p -m777 ./MEG_PREP/BRAINSTORM_BIDS/derivatives/freesurfer/${sid}/${ses}/anat/ 
       cp $SF/${sid}_Anonymized_*MPN1Scan1*/Anonymized_${sid}_ses-MPN1Scan1_T1w/QC/head.surf ./MEG_PREP/BRAINSTORM_BIDS/derivatives/freesurfer/${sid}/${ses}/anat/
       
done        
done

