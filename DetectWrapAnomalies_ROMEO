#"EchoTime2": 0.009,

#echo5:
E5="/home/hayabusa/PROJECT_MPN/MPN_BIDS/sub-MPN0000087/ses-MPN1Scan1/anat/sub-MPN0000087_ses-MPN1Scan1_acq-romeo_echo-5_part-phase_T2starw.nii.gz"
#"EchoTime": 0.0225,
#"EchoTime1": 0.0045,
#"EchoTime2": 0.009,
#** So EchoTime is EchoTime1*Number_of_Echo

# 2. Set up linear regression and ROI
#########################################

te_files = {
    "0.0045": E1,
    "0.009": E2,
    "0.0135": E3,
    "0.018": E4,
    "0.0225": E5,
}

te_times = np.array([float(te) for te in te_files.keys()])
mean_phases = []

for te, filepath in te_files.items():
  img = nib.load(filepath)
  data = img.get_fdata()

  # Optional: apply a mask or select a specific slice/ROI coordinates
  #>>> print(data.shape)
  # (240, 320, 208)
  # e.g., using a central ROI slice: data[60:180, 80:240, 52:156]
  
  roi_mean = np.mean(data[data != 0])  # simple non-zero mean as placeholder yields similar results
  
  roi_mean = np.mean(data[60:180, 80:240, 52:156])
  mean_phases.append(roi_mean)

mean_phases = np.array(mean_phases)

# 3. Test linearity via Linear Regression
##########################################
slope, intercept, r_value, p_value, std_err = linregress(
    te_times, mean_phases)
    
r_squared = r_value**2

print(f"Slope (Frequency proxy): {slope:.4f} rad/ms")
print(f"R-squared: {r_squared:.4f}")
print(f"P-value: {p_value:.4e}")

# 4. Plot the evolution and linear fit
plt.figure(figsize=(7, 5))
plt.scatter(te_times, mean_phases, color="blue", label="Measured Phase")
plt.plot(
    te_times,
    intercept + slope * te_times,
    color="red",
    linestyle="--",
    label=f"Fit: $R^2$ = {r_squared:.3f}",
)
plt.xlabel("Echo Time (TE)")
plt.ylabel("Unwrapped Phase (radians)")
plt.title("MRI Phase Evolution vs. Echo Time")
plt.legend()
plt.grid(True)
plt.show()

